{
  "$comment": "Single source of truth for the Radiant look (handoff §3, §3.1). Build against these tokens, never literals. Mocks (shared/mocks/generate.py) and the iOS tokens file must stay in sync with this file.",
  "color": {
    "void": "#050510",
    "filamentAmber": "#E8A33D",
    "ignitedGold": "#FFD98A",
    "outcomeBlue": "#6DB8FF",
    "ember": "#FF6B5E",
    "whisperCyan": "#9FE8FF",
    "parchment": "#F3ECD8",
    "mote": "#9FB4E8"
  },
  "colorRoles": {
    "background": "void",
    "edgeNeutral": "filamentAmber",
    "decisionNode": "filamentAmber",
    "selectedPath": "ignitedGold",
    "payoffPositive": "ignitedGold",
    "terminalFavorable": "outcomeBlue",
    "terminalAdverse": "ember",
    "hover": "whisperCyan",
    "secondaryInfo": "whisperCyan",
    "displayText": "parchment",
    "listeningAccent": "whisperCyan"
  },
  "type": {
    "display": {
      "family": "Cormorant Garamond",
      "license": "OFL",
      "bundled": true,
      "weights": ["light", "semibold"],
      "letterSpacing": "generous",
      "use": "node titles and rare display moments only"
    },
    "data": {
      "family": "IBM Plex Mono",
      "license": "OFL",
      "bundled": true,
      "weights": [300, 500],
      "use": "all probabilities, labels, buttons, transcript"
    }
  },
  "layout": {
    "algorithm": "radial-sector-on-shell",
    "minChildSectorFraction": 0.09,
    "onPathChildWeight": 3.2,
    "offPathSiblingWeight": 0.5,
    "reflowDurationSeconds": 1.0,
    "markHoldDurationSeconds": 0.7,
    "idleRotationDelaySeconds": 5,
    "chatSurfaceTreeOpacity": 0.15,
    "chatSurfacePatchTreeOpacity": 0.35,
    "distributionMaxBins": 6
  },
  "world": {
    "$comment": "Single-void world model (docs/radiant-implementation-notes.md §1). One scene, one camera; all content at persistent coordinates on a spherical shell.",
    "shellRadius": 280,
    "camera": {
      "homeDistanceFactor": 1.5,
      "homeTiltRadians": 0.22,
      "canvasDistanceFactor": 0.4,
      "canvasTiltRadians": 0.58
    },
    "depth": {
      "nearFarSizeRatio": 1.4,
      "minAssertedSizeRatio": 1.3,
      "dimmingExponent": 1.9,
      "dimmingFloor": 0.34,
      "dofBlurBelowProjectedScale": 0.88
    },
    "nebulaParallaxFactors": [0.15, 0.35, 0.6],
    "nebulaDriftMinutes": 4,
    "resolvedClusterLuminance": 0.42
  },
  "motion": {
    "$comment": "Targets, not laws — feel > numbers (notes §3).",
    "reflowSeconds": [0.9, 1.1],
    "igniteSweepSeconds": 0.35,
    "markRingSeconds": 0.7,
    "markCancelDrainSeconds": 0.15,
    "realizeSweepSeconds": 0.25,
    "ghostDownSeconds": 0.4,
    "evTickSeconds": 0.3,
    "diveFlightSeconds": 0.9,
    "chatEnterSeconds": 0.35,
    "chatSettleSeconds": 0.6,
    "peekReturnTravelFraction": 0.4,
    "peekSnapBackSeconds": 0.25,
    "ridgeExpandSeconds": 0.3,
    "ridgeDrawSeconds": 0.4,
    "ridgeCollapseSeconds": 0.2,
    "voicePulsePeriodSeconds": 1.6,
    "voiceTreeBrighten": 0.15,
    "composerCompressSeconds": 0.2,
    "unbornPulsePeriodSeconds": 2.4,
    "unbornPulseGlowDelta": 0.2
  },
  "haptics": {
    "$comment": "Complete map (notes §5). none: scrolling, zooming, chat.",
    "nodeSelect": "lightTick",
    "deselect": "softDouble",
    "markHoldFill": "ramp",
    "markComplete": "strongThud",
    "ribbonJump": "light",
    "clusterLift": "medium",
    "scenarioResolve": "successPattern"
  },
  "composer": {
    "$comment": "Placeholder is state, never instruction (notes §4).",
    "placeholderIdle": "describe the decision…",
    "placeholderNodeSelected": "ask about this branch…",
    "placeholderMidThread": "…",
    "sendDiscRadius": 12,
    "sendArrowStroke": 1.9,
    "micStroke": 1.2
  }
}
